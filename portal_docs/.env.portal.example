# ─── Local Development ────────────────────────────────────────────────────────
# Recommended: run `bash scripts/dev/docker-db.sh init`. It starts a MariaDB container bound
# to 127.0.0.1:3307, generates a password, and writes these settings to .env.local for you:
#
# PORTAL_DATABASE_URL=mysql://root:<generated-password>@127.0.0.1:3307/sfggc_portal
# ADMIN_SESSION_SECRET=<generated-random-string>
#
# Alternative (Homebrew/apt MariaDB): with no password, the init script and app use the Unix
# socket + your macOS user. Optional: MYSQL_UNIX_SOCKET=/path/to/mysql.sock
#
# PORTAL_DATABASE_URL=mysql://root@localhost:3306/sfggc_portal_dev

# ─── Production (AWS RDS + SES) ──────────────────────────────────────────────
PORTAL_DATABASE_URL=mysql://USER:PASSWORD@shared2.cdms8mviovca.us-west-2.rds.amazonaws.com:3306/goldengate
ADMIN_SESSION_SECRET=replace-with-a-long-random-string
PORTAL_BASE_URL=https://www.goldengateclassic.org

# AWS SES SMTP (STARTTLS on port 587, or TLS on port 465)
SMTP_HOST=email-smtp.us-west-2.amazonaws.com
SMTP_PORT=587
SMTP_USER=AKIAVU7WKXGTZZA3SOHN
SMTP_PASS=
SMTP_FROM=Golden Gate Classic <noreply@goldengateclassic.org>

# ─── Admin bootstrap (only needed for create-super-admin.sh) ─────────────────
ADMIN_EMAIL=you@example.com
ADMIN_NAME=Your Name
ADMIN_PASSWORD=only-needed-for-create-super-admin
